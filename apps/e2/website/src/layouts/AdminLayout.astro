---
import ThemeToggle from '../components/ThemeToggle.vue';
import ThemeHead from '../components/ThemeHead.astro';
import '../styles/global.css';
import '../styles/workspace.css';
interface Props { title: string; active?: 'accounts' | 'google' | 'supertags' }
const { title, active = 'accounts' } = Astro.props;

---
<!doctype html>
<html lang="en">
  <head>
    <ThemeHead />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Apsides</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="settings-shell">
      <aside class="workspace-sidebar" aria-label="Workspace">
        <a class="workspace-brand" href="/" aria-label="Apsides today">Apsides</a>
        <nav class="workspace-links" aria-label="Workspace navigation">
          <a href="/"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 7v5l3 2"/></svg>Today</a>
          <a href="/admin/supertags" aria-current={active === 'supertags' ? 'page' : undefined}><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M9 4 7 20M17 4l-2 16M4 9h16M3 15h16"/></svg>Supertags</a>
        </nav>
        <div class="workspace-sidebar-bottom">

          <nav class="workspace-links" aria-label="Connected services">
            <a href="/admin/google" aria-current={active === 'google' ? 'page' : undefined}><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="3"/><path d="M8 3v4m8-4v4M4 10h16m-11 4h2m3 0h2"/></svg>Contacts &amp; events</a>
            <a href="/admin/oauth" aria-current={active === 'accounts' ? 'page' : undefined}><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg>Accounts</a>
          </nav>
          <ThemeToggle client:load />
        </div>
      </aside>
      <div class="workspace-content">
        <header class="workspace-topbar"><div class="workspace-identity"><span>{Astro.locals.admin.email}</span><a href="/cdn-cgi/access/logout">Sign out</a></div></header>
      <main id="main"><slot /></main>
      </div>
    </div>
    <script>
      document.querySelectorAll<HTMLFormElement>('form[data-pending]').forEach((form) => {
        form.addEventListener('submit', () => {
          form.querySelectorAll<HTMLButtonElement>('button[type="submit"]').forEach((button) => {
            button.disabled = true;
            button.textContent = form.dataset.pending ?? 'Working…';
          });
        });
      });
    </script>
  </body>
</html>
