---
import '../styles/global.css';
interface Props { title: string; active?: 'accounts' | 'google' | 'supertags' }
const { title, active = 'accounts' } = Astro.props;
const context = active === 'supertags' ? 'Structured workspace' : 'Connected data';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Apsides</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="masthead">
      <a class="wordmark" href="/">Apsides<span>{context}</span></a>
      <div class="identity"><span>{Astro.locals.admin.email}</span><a href="/cdn-cgi/access/logout">Sign out</a></div>
    </header>
    <div class="workspace">
      <nav aria-label="Main navigation">
        <a href="/">Today</a>
        <a href="/admin/oauth" aria-current={active === 'accounts' ? 'page' : undefined}>Accounts</a>
        <a href="/admin/google" aria-current={active === 'google' ? 'page' : undefined}>Contacts & events</a>
        <a href="/admin/supertags" aria-current={active === 'supertags' ? 'page' : undefined}>Supertags</a>
      </nav>
      <main id="main"><slot /></main>
    </div>
    <script>
      document.querySelectorAll<HTMLFormElement>('form[data-pending]').forEach((form) => {
        form.addEventListener('submit', () => {
          form.querySelectorAll<HTMLButtonElement>('button[type="submit"]').forEach((button) => {
            button.disabled = true;
            button.textContent = form.dataset.pending ?? 'Working…';
          });
        });
      });
    </script>
  </body>
</html>
