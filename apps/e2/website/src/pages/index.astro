---
import PaneWorkspace from '../components/PaneWorkspace.vue';
import { parsePaneStack } from '../editor/paneStack';
import '../styles/editor.css';

const parsedPanes = parsePaneStack(Astro.url.searchParams);
const initialPanes = parsedPanes.ok ? parsedPanes.panes : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Today · Apsides</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to editor</a>
    <PaneWorkspace client:only="vue" initialPanes={initialPanes}><p slot="fallback">Opening today…</p></PaneWorkspace>
    <noscript>Enable JavaScript to write your daily note.</noscript>
  </body>
</html>
