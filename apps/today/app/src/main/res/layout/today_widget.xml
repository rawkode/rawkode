<!-- Heights here are mirrored in WidgetLayout, which decides how many rows fit. Keep them in sync. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_body" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_background"
    android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="12dp" android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <!-- Top gravity (the default) lets the day and date share a baseline. -->
        <LinearLayout android:id="@+id/calendar_heading" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/widget_day" style="@style/WidgetDay" />
            <TextView android:id="@+id/widget_date" style="@style/WidgetDate" />
        </LinearLayout>
        <!-- Negative margin aligns the icon, not its touch target, with the content edge. -->
        <ImageView android:id="@+id/refresh" android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginEnd="-10dp" android:padding="10dp" android:src="@drawable/ic_refresh"
            android:background="@drawable/touch_feedback_round" android:contentDescription="@string/widget_refresh" />
    </LinearLayout>

    <TextView android:id="@+id/widget_message" style="@style/WidgetMessage" android:text="@string/widget_permission" />

    <LinearLayout android:id="@+id/clear_state" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:visibility="gone">
        <ImageView android:layout_width="96dp" android:layout_height="54dp" android:src="@drawable/clear_horizon"
            android:contentDescription="@null" android:importantForAccessibility="no" />
        <TextView android:id="@+id/clear_title" style="@style/ClearTitle" android:text="@string/clear_morning" />
        <TextView style="@style/ClearCaption" android:text="@string/clear_caption" />
    </LinearLayout>

    <LinearLayout android:id="@+id/next_event" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/next_label" style="@style/NextLabel" />
            <TextView android:id="@+id/next_conflict" style="@style/ConflictBadge" />
        </LinearLayout>
        <TextView android:id="@+id/next_title" style="@style/NextTitle" />
        <TextView android:id="@+id/next_time" style="@style/Detail" android:layout_marginTop="6dp"
            android:drawableStart="@drawable/ic_clock" />
        <TextView android:id="@+id/next_location" style="@style/Detail" android:layout_marginTop="2dp" android:minHeight="32dp"
            android:drawableStart="@drawable/ic_location" android:background="@drawable/touch_feedback" android:visibility="gone" />
        <TextView android:id="@+id/join_meeting" style="@style/JoinButton" android:layout_marginTop="12dp"
            android:text="@string/join_meeting" android:visibility="gone" />
    </LinearLayout>

    <ImageView android:id="@+id/event_divider" android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginTop="14dp" android:layout_marginBottom="4dp" android:background="@color/today_outline" android:contentDescription="@null" android:importantForAccessibility="no" android:visibility="gone" />
    <LinearLayout android:id="@+id/later_events" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" />
    <TextView android:id="@+id/more_events" style="@style/MoreEvents" />
</LinearLayout>
