{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "athenaeum-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-02",

  // Phase 5 addition: the first real `GATEKEEPER_*` service binding (see `src/index.ts`'s own
  // header comment — the env-key name IS the routing config: `GATEKEEPER_GOOGLE_CALENDAR` ->
  // `/gatekeeper/google-calendar/*`). A second gatekeeper later means one more entry here, no
  // code change.
  "services": [
    {
      "binding": "BACKEND",
      "service": "athenaeum-backend"
    },
    {
      "binding": "GATEKEEPER_GOOGLE_CALENDAR",
      "service": "athenaeum-gatekeeper-google-calendar"
    }
  ],

  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
