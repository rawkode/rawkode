{
  "name": "@athenaeum/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Backend Worker: WorkspaceDurableObject + UserDurableObject, Cap'n Web RPC boundary. The 'kernel'.",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "echo 'not for Phase 0 — do not run wrangler deploy' >&2 && exit 1",
    "build": "tsc",
    "clean": "rm -rf dist .wrangler",
    "test:run": "vitest run",
    "test:loro-native": "node scripts/verify-loro-native.mjs",
    "test:mutation-routing-audit": "node scripts/verify-mutation-routing-manifest.mjs",
    "test:authority-local-callback": "node scripts/verify-authority-local-callback.mjs",
    "test:authority-local-callback-fixtures": "node scripts/test-authority-local-callback.mjs",
    "test:authority-local-source-audit": "node scripts/test-authority-local-source-audit.mjs",
    "test:protected-path-snapshot": "node scripts/test-protected-path-snapshot.mjs",
    "test:standup-publication-private-reachability": "node scripts/verify-standup-publication-private-reachability.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@athenaeum/domain": "workspace:*",
    "@athenaeum/typed-storage-effect": "workspace:*",
    "@automerge/automerge": "catalog:",
    "capnweb": "catalog:",
    "effect": "catalog:",
    "loro-crdt": "catalog:"
  },
  "devDependencies": {
    "@athenaeum/gatekeeper-google-calendar": "workspace:*",
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
