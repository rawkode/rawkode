<section class="notebook" aria-label="Daily document">
  <div class="document-meta"><span>Daily note</span><span id="save-status" role="status">Opening document…</span></div>
  <div id="editor" class="editor-mount" aria-busy="true"></div>
  <div class="document-footer"><span id="word-count">A little space to think.</span><button id="insert-block">Insert a block <kbd>⌘ K</kbd></button></div>
  <div id="editor-error" class="editor-error" role="alert" hidden></div>
</section>
