{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "enchiridion-website",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "services": [
    { "binding": "OAUTH_ADMIN", "service": "enchiridion-oauth", "entrypoint": "OAuthAdmin" },
    { "binding": "OAUTH_CALLBACK", "service": "enchiridion-oauth" },
    { "binding": "CALENDAR_ADMIN", "service": "enchiridion-google-calendar", "entrypoint": "CalendarAdmin" }
  ],
  "vars": { "WEBSITE_ORIGIN": "http://localhost:4321" }
}
