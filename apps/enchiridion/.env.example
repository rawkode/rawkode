# Load with Node's --env-file=.env from the Deno Alchemy tasks.
# WEBSITE_DOMAIN comes from cuenv development/production; workers derive their
# HTTPS WEBSITE_ORIGIN from it.

# Alchemy creates the encryption keyring and service credentials in Secrets Store.
# Run Alchemy through cuenv to resolve Google and GitHub credentials from 1Password
# (env.cue). Leave the optional fields below blank when running without cuenv.
# No application secret values are required in this file.

# Optional GitHub OAuth app credentials when running without cuenv. The OAuth app
# must have a callback at https://<domain>/oauth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional Gmail Pub/Sub configuration; blank disables push/watch features.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_AUDIENCE=
GMAIL_PUSH_SERVICE_ACCOUNT=
GMAIL_PUSH_SUBSCRIPTION=

# Test-only loopback provider. Leave blank for real Google and GitHub APIs.
LOCAL_PROVIDER_ORIGIN=
