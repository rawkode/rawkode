<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Enchiridion</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Enchiridion Tasks</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>enchiridion</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>Google Calendar OAuth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.CONFIGURE_GOOGLE_OAUTH_CLIENT_ID</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>EnchiridionCodeSignEntitlements</key>
	<string>$(CODE_SIGN_ENTITLEMENTS)</string>
	<key>EnchiridionCodeSigningAllowed</key>
	<string>$(CODE_SIGNING_ALLOWED)</string>
	<key>GoogleOAuthClientID</key>
	<string>CONFIGURE_GOOGLE_OAUTH_CLIENT_ID</string>
	<key>GoogleOAuthRedirectScheme</key>
	<string>com.googleusercontent.apps.CONFIGURE_GOOGLE_OAUTH_CLIENT_ID</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Enchiridion shows your local calendar events so you can attach private notes. It never edits events.</string>
	<key>NSContactsUsageDescription</key>
	<string>Enchiridion uses contacts you allow to enrich people already found in your calendars. It never imports your address book.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Enchiridion uses the microphone only while you are talking to its on-device assistant.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Enchiridion transcribes your questions on device so it can answer from your private calendar and notes.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>CPTemplateApplicationScene</string>
					<key>UISceneConfigurationName</key>
					<string>CarPlay Voice</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
