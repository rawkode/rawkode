{
  "name": "@enchiridion/oauth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --preload ../../scripts/cloudflare-bun.ts ./node_modules/wrangler/bin/wrangler.js dev --port 8787 --inspector-port 9230",
    "build": "bun --preload ../../scripts/cloudflare-bun.ts ./node_modules/wrangler/bin/wrangler.js deploy --dry-run --outdir dist",
    "check": "bun x --bun tsc --noEmit",
    "test": "bun test",
    "db:migrate": "bun x --bun wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "bun x --bun wrangler d1 migrations apply DB --remote",
    "deploy": "bun x --bun wrangler deploy"
  },
  "dependencies": {
    "@enchiridion/oauth-client": "workspace:*",
    "capnweb": "^0.12.0",
    "oauth4webapi": "^3.8.8"
  },
  "devDependencies": { "@cloudflare/workers-types": "latest", "wrangler": "^4.130.0" }
}
