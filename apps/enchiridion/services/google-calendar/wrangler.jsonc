{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "enchiridion-google-calendar", "main": "src/index.ts", "compatibility_date": "2026-09-08",
  "workers_dev": false, "preview_urls": false,
  "d1_databases": [{ "binding": "DB", "database_name": "enchiridion-google-calendar", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations" }],
  "services": [{ "binding": "OAUTH", "service": "enchiridion-oauth", "entrypoint": "OAuthIntegrations" }],
  "durable_objects": { "bindings": [{ "name": "GOOGLE_ACCOUNTS", "class_name": "GoogleAccount" }] },
  "migrations": [{ "tag": "v1-google-accounts", "new_sqlite_classes": ["GoogleAccount"] }],
  "triggers": { "crons": ["*/15 * * * *"] }
}
