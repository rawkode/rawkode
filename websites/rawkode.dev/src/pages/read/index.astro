---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { calculateReadingMinutes } from '../../utils/readingTime';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const blogDescription =
  'Thoughts from David Flanagan on cloud-native infrastructure, developer tooling, open source, and building in public.';
const siteUrl = new URL('/', Astro.site ?? 'https://rawkode.dev');
const blogUrl = new URL('/read', siteUrl).toString();
const personId = new URL('/#person', siteUrl).toString();
const blogJsonLd = {
  '@type': 'Blog',
  '@id': `${blogUrl}#blog`,
  name: 'Writing | rawkode.dev',
  description: blogDescription,
  url: blogUrl,
  author: { '@id': personId },
  publisher: { '@id': personId },
  blogPost: posts.map((post) => {
    const url = new URL(`/read/${post.id}`, siteUrl).toString();
    return {
      '@type': 'BlogPosting',
      '@id': `${url}#article`,
      headline: post.data.title,
      description: post.data.description,
      url,
      datePublished: post.data.pubDate.toISOString(),
    };
  }),
  inLanguage: 'en-GB',
};

function formatDate(date: Date) {
  return date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}

---

<Layout
  title="Writing | rawkode.dev"
  description={blogDescription}
  imageAlt="Writing from David Flanagan on rawkode.dev"
  jsonLd={blogJsonLd}
>
  <Nav />

  <main id="main-content">
    <section class="writing-hero" aria-labelledby="writing-title">
      <div class="container writing-hero__inner">
        <h1 id="writing-title" class="poster">Writing</h1>
        <p>
          Field notes on infrastructure, developer tooling, and building in public.
          <span class="writing-hero__count">{posts.length} {posts.length === 1 ? 'piece' : 'pieces'} so far.</span>
        </p>
      </div>
    </section>

    <section class="writing-content" aria-label="All writing">
      <div class="container">
        {posts.length === 0 ? (
          <p class="empty">Nothing published yet. The first piece is on its way.</p>
        ) : (
          <ol class="post-list" role="list">
            {posts.map((post) => (
              <li>
                <a href={`/read/${post.id}`} class="post-row">
                  <span class="post-row__meta">
                    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                    <span>{calculateReadingMinutes(post.body)} min read</span>
                  </span>
                  <span class="post-row__content">
                    <h2>{post.data.title}</h2>
                    <p>{post.data.description}</p>
                    {post.data.tags.length > 0 && (
                      <span class="post-row__tags">
                        {post.data.tags.map((tag: string) => <span>#{tag}</span>)}
                      </span>
                    )}
                  </span>
                  <svg class="post-row__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
                    <path d="M5 12h14M13 5l7 7-7 7"/>
                  </svg>
                </a>
              </li>
            ))}
          </ol>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .writing-hero {
    padding-block: clamp(2.5rem, 7vw, 6rem) clamp(2.5rem, 5vw, 4rem);
  }

  .writing-hero__inner {
    display: grid;
    gap: var(--space-6);
    align-items: end;
    container-type: inline-size;
  }

  .writing-hero h1 {
    margin: 0;
    font-size: min(14rem, 100cqi / 3.75);
    line-height: 0.82;
  }

  .writing-hero p {
    max-width: 30ch;
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    line-height: 1.5;
  }

  .writing-hero__count {
    display: block;
    margin-top: var(--space-2);
    color: var(--text-tertiary);
    font-size: 0.95rem;
  }

  .writing-content {
    padding-block: 0 clamp(4rem, 9vw, 7rem);
  }

  .empty {
    padding-block: var(--space-8);
    border-top: 1px solid var(--border-default);
    color: var(--text-secondary);
  }

  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--border-default);
  }

  .post-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-3) var(--space-6);
    padding-block: var(--space-8);
    border-top: 1px solid var(--border-default);
    color: var(--text-primary);
    text-decoration: none;
  }

  .post-row__meta {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    color: var(--text-tertiary);
    font-size: 0.92rem;
  }

  .post-row__content {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }

  .post-row h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4.4vw, 3.4rem);
    line-height: 1.02;
    transition: color var(--dur-fast) var(--ease-out-expo);
  }

  .post-row p {
    max-width: 62ch;
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .post-row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    color: var(--text-tertiary);
    font-size: 0.92rem;
  }

  .post-row__arrow {
    align-self: center;
    width: 32px;
    height: 32px;
    color: var(--text-tertiary);
    transition:
      transform var(--dur-normal) var(--ease-out-expo),
      color var(--dur-fast) var(--ease-out-expo);
  }

  .post-row:hover {
    color: var(--text-primary);
  }

  .post-row:hover h2,
  .post-row:hover .post-row__arrow {
    color: var(--color-accent);
  }

  .post-row:hover .post-row__arrow {
    transform: translateX(6px);
  }

  @media (min-width: 900px) {
    .writing-hero__inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .writing-hero h1 {
      font-size: min(14rem, 100cqi / 5.2);
    }

    .post-row {
      grid-template-columns: 11rem minmax(0, 1fr) auto;
    }

    .post-row__meta {
      grid-column: auto;
      flex-direction: column;
      padding-top: 0.6rem;
    }
  }
</style>
