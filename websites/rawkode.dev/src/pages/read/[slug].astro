---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { calculateReadingMinutes, calculateWordCount } from '../../utils/readingTime';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2);

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const chronological = allPosts.sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
const total = chronological.length;
const index = chronological.findIndex((p) => p.id === post.id);
const previous = index > 0 ? chronological[index - 1] : null;
const next = index < total - 1 ? chronological[index + 1] : null;

function formatDate(date: Date) {
  return date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}

const wordCount = calculateWordCount(post.body ?? '');
const readMinutes = calculateReadingMinutes(post.body ?? '');
const siteUrl = new URL('/', Astro.site ?? 'https://rawkode.dev');
const personId = new URL('/#person', siteUrl).toString();
const postUrl = new URL(`/read/${post.id}`, siteUrl).toString();
const postImage = post.data.image ?? '/og.png';
const postImageUrl = new URL(postImage, siteUrl).toString();
const postImageAlt = post.data.imageAlt ?? `${post.data.title} | rawkode.dev`;
const publishedTime = post.data.pubDate.toISOString();
const modifiedTime = post.data.updatedDate?.toISOString() ?? publishedTime;
const articleJsonLd = {
  '@type': 'BlogPosting',
  '@id': `${postUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  url: postUrl,
  mainEntityOfPage: { '@id': `${postUrl}#webpage` },
  image: [{ '@type': 'ImageObject', url: postImageUrl, caption: postImageAlt }],
  datePublished: publishedTime,
  dateModified: modifiedTime,
  author: { '@id': personId },
  publisher: { '@id': personId },
  keywords: post.data.tags.join(', '),
  wordCount,
  timeRequired: `PT${readMinutes}M`,
  inLanguage: 'en-GB',
};
---

<Layout
  title={`${post.data.title} | rawkode.dev`}
  description={post.data.description}
  image={postImage}
  imageAlt={postImageAlt}
  type="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  tags={post.data.tags}
  jsonLd={articleJsonLd}
>
  <Nav />
  <div class="progress" aria-hidden="true"></div>

  <main id="main-content">
    <article class="article">
      <header class="article__header">
        <div class="container">
          <a href="/read" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
              <path d="M19 12H5M11 5l-7 7 7 7"/>
            </svg>
            All writing
          </a>
          <h1>{post.data.title}</h1>
          <p class="article__deck">{post.data.description}</p>
          <dl class="article__meta">
            <div>
              <dt>Published</dt>
              <dd><time datetime={publishedTime}>{formatDate(post.data.pubDate)}</time></dd>
            </div>
            {modifiedTime !== publishedTime && (
              <div>
                <dt>Updated</dt>
                <dd><time datetime={modifiedTime}>{formatDate(new Date(modifiedTime))}</time></dd>
              </div>
            )}
            <div>
              <dt>Length</dt>
              <dd>{readMinutes} min read, {wordCount.toLocaleString('en-GB')} words</dd>
            </div>
            {post.data.tags.length > 0 && (
              <div>
                <dt>Tags</dt>
                <dd class="article__tags">{post.data.tags.map((tag: string) => <span>#{tag}</span>)}</dd>
              </div>
            )}
          </dl>
        </div>
      </header>

      <div class="container article__layout">
        <div class="prose">
          <Content />
        </div>

        {toc.length > 1 && (
          <aside class="toc" aria-labelledby="toc-title">
            <p id="toc-title" class="toc__title">On this page</p>
            <ol role="list">
              {toc.map((heading) => (
                <li><a href={`#${heading.slug}`} data-toc={heading.slug}>{heading.text}</a></li>
              ))}
            </ol>
          </aside>
        )}
      </div>

      {(previous || next) && (
        <nav class="container pager" aria-label="More writing">
          {previous ? (
            <a href={`/read/${previous.id}`} class="pager__link">
              <span>Previous</span>
              <strong>{previous.data.title}</strong>
            </a>
          ) : <span />}
          {next && (
            <a href={`/read/${next.id}`} class="pager__link pager__link--next">
              <span>Next</span>
              <strong>{next.data.title}</strong>
            </a>
          )}
        </nav>
      )}
    </article>
  </main>

  <Footer />
</Layout>

<script>
  // Highlight the section currently being read in the table of contents.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')].map((link) => [link.dataset.toc, link]),
  );
  if (links.size > 0 && 'IntersectionObserver' in window) {
    const setActive = (id: string) => {
      links.forEach((link, key) => link.toggleAttribute('aria-current', key === id));
    };
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting);
        if (visible.length > 0) setActive(visible[0].target.id);
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );
    links.forEach((_, id) => {
      const heading = id ? document.getElementById(id) : null;
      if (heading) observer.observe(heading);
    });
  }
</script>

<style>
  /* Reading progress: a signal-red bar under the nav, driven by scroll. */
  .progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .progress {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: var(--z-toast);
      display: block;
      height: 3px;
      background: var(--color-accent);
      transform-origin: left;
      animation: progress linear both;
      animation-timeline: scroll(root);
    }

    @keyframes progress {
      from { transform: scaleX(0); }
      to { transform: scaleX(1); }
    }
  }

  .article__header {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(2.5rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--border-subtle);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
    color: var(--text-secondary);
    font-weight: 600;
    text-decoration: none;
  }

  .back-link svg {
    width: 18px;
    height: 18px;
    transition: transform var(--dur-normal) var(--ease-out-expo);
  }

  .back-link:hover svg {
    transform: translateX(-4px);
  }

  .article__header h1 {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 5.6rem);
    font-stretch: 72%;
    font-weight: 820;
    line-height: 0.95;
  }

  .article__deck {
    max-width: 48ch;
    margin: var(--space-6) 0 0;
    color: var(--text-primary);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.45;
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-10);
    margin: clamp(2rem, 4vw, 3rem) 0 0;
  }

  .article__meta dt {
    color: var(--text-tertiary);
    font-size: 0.88rem;
  }

  .article__meta dd {
    margin: var(--space-1) 0 0;
    color: var(--text-primary);
    font-weight: 560;
  }

  .article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .article__layout {
    display: grid;
    gap: var(--space-10);
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  /* ─── Table of contents ────────────────────────────────────────────── */
  .toc {
    display: none;
  }

  .toc__title {
    margin: 0 0 var(--space-3);
    color: var(--text-primary);
    font-weight: 650;
  }

  .toc ol {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--border-default);
  }

  .toc a {
    display: block;
    margin-left: -1px;
    padding: 0.35rem 0 0.35rem var(--space-4);
    border-left: 2px solid transparent;
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.35;
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-out-expo),
      border-color var(--dur-fast) var(--ease-out-expo);
  }

  .toc a:hover,
  .toc a[aria-current] {
    border-left-color: var(--color-accent);
    color: var(--text-primary);
  }

  /* ─── Prose ────────────────────────────────────────────────────────── */
  .prose {
    min-width: 0;
    max-width: var(--measure);
    color: var(--text-primary);
    font-size: clamp(1.05rem, 1.4vw, 1.125rem);
    line-height: 1.72;
  }

  .prose :global(*) {
    max-width: 100%;
  }

  .prose :global(p) {
    margin: var(--space-5) 0 0;
    color: var(--text-primary);
  }

  .prose :global(> :first-child) {
    margin-top: 0;
  }

  .prose :global(h2) {
    margin: var(--space-16) 0 var(--space-4);
    padding-top: var(--space-4);
    border-top: 2px solid var(--text-primary);
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    font-stretch: 72%;
    font-weight: 820;
    line-height: 1;
    scroll-margin-top: calc(var(--nav-height-offset) + var(--space-4));
  }

  .prose :global(h3) {
    margin: var(--space-10) 0 var(--space-2);
    font-size: 1.4rem;
    scroll-margin-top: calc(var(--nav-height-offset) + var(--space-4));
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: var(--space-4) 0 0;
    padding-left: var(--space-6);
  }

  .prose :global(li) {
    margin-top: var(--space-2);
    line-height: 1.6;
  }

  .prose :global(li::marker) {
    color: var(--color-accent);
  }

  .prose :global(a) {
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
  }

  .prose :global(blockquote) {
    margin: var(--space-10) 0;
    padding: 0 0 0 var(--space-6);
    color: var(--text-primary);
    font-size: 1.25em;
    font-style: italic;
    line-height: 1.5;
    quotes: none;
  }

  .prose :global(blockquote::before) {
    content: "";
    display: block;
    width: 2.5rem;
    height: 0.5rem;
    margin-bottom: var(--space-3);
    background: var(--color-accent);
  }

  .prose :global(blockquote p) {
    margin: 0;
    color: inherit;
  }

  .prose :global(hr) {
    height: 1px;
    margin: var(--space-12) 0;
    border: 0;
    background: var(--border-default);
  }

  .prose :global(.expressive-code) {
    margin-block: var(--space-8);
  }

  .prose :global(.expressive-code .frame) {
    border-radius: var(--radius-sm);
    box-shadow: none;
  }

  .prose :global(> pre) {
    overflow-x: auto;
    margin-block: var(--space-8);
    padding: var(--space-5);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    color: var(--text-primary);
    font-family: var(--fonts-mono);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .prose :global(> pre code) {
    padding: 0;
    background: none;
    color: inherit;
    font-size: inherit;
  }

  .prose :global(table) {
    display: block;
    overflow-x: auto;
    margin-block: var(--space-8);
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-2) var(--space-4) var(--space-2) 0;
    border-bottom: 1px solid var(--border-default);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(aside.sidenote),
  .prose :global(aside.marginalia) {
    margin: var(--space-8) 0;
    padding: var(--space-5);
    background: var(--color-accent-muted);
    color: var(--text-primary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .prose :global(.footnotes) {
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-default);
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  /* ─── Pager ────────────────────────────────────────────────────────── */
  .pager {
    display: grid;
    gap: var(--space-4);
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .pager__link {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 2px solid var(--text-primary);
    color: var(--text-primary);
    text-decoration: none;
  }

  .pager__link span {
    color: var(--text-tertiary);
    font-size: 0.9rem;
  }

  .pager__link strong {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-stretch: var(--stretch-head);
    font-weight: 780;
    line-height: 1.1;
    transition: color var(--dur-fast) var(--ease-out-expo);
  }

  .pager__link:hover strong {
    color: var(--color-accent);
  }

  @media (min-width: 1000px) {
    .article__layout {
      grid-template-columns: minmax(0, var(--measure)) minmax(12rem, 16rem);
      justify-content: space-between;
      align-items: start;
      gap: var(--space-16);
    }

    .toc {
      position: sticky;
      top: calc(var(--nav-height-offset) + var(--space-4));
      display: block;
    }

    .pager {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-12);
    }

    .pager__link--next {
      text-align: right;
    }
  }
</style>
