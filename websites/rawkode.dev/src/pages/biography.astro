---
export const prerender = true;

import rawkodePhoto from '../assets/rawkode.jpg';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { calculateWordCount } from '../utils/readingTime';

const tagline =
  'Helping developers, platform engineers, and infrastructure operators level up with Kubernetes.';

const bios = [
  {
    id: 'short',
    label: 'Short',
    paragraphs: [
      'David Flanagan (aka rawkode) is a Senior Solutions Engineer at CoreWeave and the founder of Rawkode Academy, where he teaches engineers the practical work behind Kubernetes, platform engineering, and cloud-native infrastructure.',
    ],
  },
  {
    id: 'medium',
    label: 'Medium',
    paragraphs: [
      "Based in Glasgow, Scotland, David Flanagan (better known as rawkode) has spent twenty years close to the metal, from embedded C to the GPU clusters powering today's AI. As a Senior Solutions Engineer at CoreWeave he helps teams tame that infrastructure, and as the founder of Rawkode Academy he gives the knowledge away, teaching Kubernetes, platform engineering, and cloud-native systems through free courses and building in the open.",
    ],
  },
  {
    id: 'long',
    label: 'Long',
    paragraphs: [
      'Based in Glasgow, Scotland, David Flanagan, better known online as rawkode, has spent twenty years close to the metal. He began with embedded C in 2004 and worked his way up the stack as the industry moved from bare servers to containers to the GPU clusters now powering modern AI.',
      'Today he sits at that frontier as a Senior Solutions Engineer at CoreWeave, helping teams run demanding AI workloads where Kubernetes meets large-scale GPU compute. The same instinct to make hard infrastructure approachable runs through Rawkode Academy, the company he founded, where he gives that knowledge away, building in the open and publishing free courses on Kubernetes, platform engineering, and cloud-native systems so developers, platform engineers, and infrastructure operators can level up alongside him.',
      "Away from the terminal, he's usually buried in science fiction, working through a craft beverage, or slowly making peace with the piano.",
    ],
  },
];

const facts: { label: string; value: string; status?: boolean }[] = [
  { label: 'Focus', value: 'Developer tooling, platform engineering, authz, and systems' },
  { label: 'Current', value: 'Building in public, shipping tools, teaching at Rawkode Academy' },
  { label: 'Format', value: 'Keynotes, talks, panels, workshops' },
];

const topics = [
  'Developer Tooling',
  'Platform Engineering',
  'Kubernetes',
  'Authorization & SpiceDB',
  'CUE',
  'Rust',
  'Open Source',
  'Build in Public',
  'Infrastructure',
  'Security',
];

const socials = [
  { label: 'Email', handle: 'david@rawkode.dev', href: 'mailto:david@rawkode.dev' },
  { label: 'Website', handle: 'rawkode.dev', href: 'https://rawkode.dev' },
  { label: 'Academy', handle: 'rawkode.academy', href: 'https://rawkode.academy' },
  { label: 'GitHub', handle: 'github.com/rawkode', href: 'https://github.com/rawkode' },
  { label: 'Bluesky', handle: '@rawkode.dev', href: 'https://bsky.app/profile/rawkode.dev' },
  { label: 'LinkedIn', handle: '/in/rawkode', href: 'https://linkedin.com/in/rawkode' },
];

const factId = (label: string) => `fact-${label.toLowerCase().replaceAll(' ', '-')}`;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'David Flanagan',
  alternateName: 'rawkode',
  jobTitle: 'Senior Solutions Engineer',
  worksFor: { '@type': 'Organization', name: 'CoreWeave' },
  founder: { '@type': 'Organization', name: 'Rawkode Academy', url: 'https://rawkode.academy' },
  address: { '@type': 'PostalAddress', addressLocality: 'Glasgow', addressCountry: 'GB' },
  description: bios[0].paragraphs.join(' '),
  url: 'https://rawkode.dev/biography',
  sameAs: socials.map((s) => s.href),
};
---

<Layout
  title="Biography & Speaker Kit | David Flanagan"
  description="Speaker kit for David Flanagan (rawkode): bios, headshot, and the details conference organisers need for their schedule."
  type="profile"
  jsonLd={personJsonLd}
>
  <Nav />
  <main id="main-content">
    <section class="kit-hero" aria-labelledby="kit-title">
      <div class="container kit-hero__inner">
        <div class="kit-hero__copy">
          <p class="kit-hero__kicker">Speaker kit</p>
          <h1 id="kit-title" class="poster">David<br />Flanagan</h1>
          <p class="kit-hero__tagline">{tagline}</p>
          <dl class="kit-hero__status">
            <div>
              <dt>Availability</dt>
              <dd><span class="status-dot" aria-hidden="true"></span>Available for speaking</dd>
            </div>
            <div>
              <dt>Based in</dt>
              <dd>Glasgow, Scotland</dd>
            </div>
            <div>
              <dt>Travel</dt>
              <dd>Worldwide</dd>
            </div>
          </dl>
        </div>

        <figure class="headshot">
          <img
            src={rawkodePhoto.src}
            width={rawkodePhoto.width}
            height={rawkodePhoto.height}
            alt="David Flanagan smiling at the camera, short red hair and beard, black t-shirt"
            class="headshot__photo"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption>
            <a href={rawkodePhoto.src} download="david-flanagan-headshot.jpg" class="button button--primary headshot__download">
              Download headshot
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
                <path d="M12 4v12M6 10l6 6 6-6M5 20h14"/>
              </svg>
            </a>
            <span>Full resolution, {rawkodePhoto.width} × {rawkodePhoto.height} JPEG</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="kit-section" aria-labelledby="bios-title">
      <div class="container">
        <header class="kit-section__head">
          <h2 id="bios-title" class="poster">Bios</h2>
          <p>Third person, ready to paste into a programme. Pick the length your schedule allows.</p>
        </header>
        <ol class="bios" role="list">
          {bios.map((bio) => (
            <li class="bio">
              <div class="bio__side">
                <h3 class="bio__label poster">{bio.label}</h3>
                <p class="bio__count">{calculateWordCount(bio.paragraphs.join(' '))} words</p>
                <button class="copy-btn" type="button" data-copy-target={`bio-${bio.id}`}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
                    <rect x="9" y="9" width="11" height="11"/><path d="M5 15V5h10"/>
                  </svg>
                  <span class="copy-btn__label">Copy {bio.label.toLowerCase()} bio</span>
                </button>
              </div>
              <div class="bio__text" id={`bio-${bio.id}`}>
                {bio.paragraphs.map((para) => <p>{para}</p>)}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="kit-section" aria-labelledby="facts-title">
      <div class="container kit-split">
        <div>
          <header class="kit-section__head">
            <h2 id="facts-title" class="poster">Facts</h2>
          </header>
          <dl class="facts">
            {facts.map((fact) => (
              <div class="facts__row">
                <dt>{fact.label}</dt>
                <dd>
                  {fact.status && <span class="status-dot" aria-hidden="true"></span>}
                  <span id={factId(fact.label)}>{fact.value}</span>
                </dd>
                <button class="copy-btn copy-btn--icon" type="button" data-copy-target={factId(fact.label)} aria-label={`Copy ${fact.label}`}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
                    <rect x="9" y="9" width="11" height="11"/><path d="M5 15V5h10"/>
                  </svg>
                </button>
              </div>
            ))}
          </dl>
        </div>

        <div>
          <header class="kit-section__head">
            <h2 id="topics-title" class="poster">Topics</h2>
          </header>
          <ul class="topics topics--large" role="list" aria-labelledby="topics-title">
            {topics.map((topic) => <li>{topic}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="kit-section" aria-labelledby="links-title">
      <div class="container">
        <header class="kit-section__head">
          <h2 id="links-title" class="poster">Links</h2>
          <p>For the speaker page, the social posts, and the "find him online" slide.</p>
        </header>
        <ul class="links" role="list">
          {socials.map((social) => {
            const external = !social.href.startsWith('mailto:');
            return (
              <li>
                <a href={social.href} {...(external ? { target: '_blank', rel: 'me noopener noreferrer' } : {})}>
                  <span class="links__label">{social.label}</span>
                  <strong class="links__handle">{social.handle}</strong>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
                    <path d="M7 17 17 7M9 7h8v8"/>
                  </svg>
                  {external && <span class="sr-only">(opens in a new tab)</span>}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const supportsCopy = !!(navigator.clipboard && navigator.clipboard.writeText);

  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    if (!supportsCopy) {
      btn.hidden = true;
      return;
    }

    const targetId = btn.dataset.copyTarget;
    const labelEl = btn.querySelector<HTMLElement>('.copy-btn__label');
    const defaultLabel = labelEl?.textContent ?? 'Copy';
    let resetTimer: number | undefined;

    btn.addEventListener('click', async () => {
      const target = targetId ? document.getElementById(targetId) : null;
      if (!target) return;
      const paragraphs = target.querySelectorAll('p');
      const text = paragraphs.length
        ? [...paragraphs].map((p) => p.textContent?.trim() ?? '').filter(Boolean).join('\n\n')
        : (target.textContent ?? '').trim();
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        btn.classList.add('is-copied');
        if (labelEl) labelEl.textContent = 'Copied';
        window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          btn.classList.remove('is-copied');
          if (labelEl) labelEl.textContent = defaultLabel;
        }, 1800);
      } catch {
        /* clipboard write blocked; visible text remains selectable */
      }
    });
  });
</script>

<style>
  /* ─── Hero ─────────────────────────────────────────────────────────── */
  .kit-hero {
    padding-block: clamp(2.5rem, 7vw, 6rem) clamp(3rem, 7vw, 6rem);
  }

  .kit-hero__inner {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  .kit-hero__copy {
    display: grid;
    align-content: end;
    gap: var(--space-6);
  }

  .kit-hero__kicker {
    margin: 0;
    color: var(--color-accent);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-stretch: 125%;
    font-style: italic;
    font-weight: 560;
  }

  .kit-hero h1 {
    margin: 0;
    font-size: clamp(4.5rem, 20vw, 10rem);
    line-height: 0.84;
  }

  .kit-hero__tagline {
    max-width: 36ch;
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    line-height: 1.5;
  }

  .kit-hero__status {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-4);
    margin: 0;
  }

  .kit-hero__status div {
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-default);
  }

  .kit-hero__status dt {
    color: var(--text-tertiary);
    font-size: 0.9rem;
  }

  .kit-hero__status dd {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin: var(--space-1) 0 0;
    font-weight: 650;
  }

  .status-dot {
    flex: none;
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--color-accent-success);
    box-shadow: 0 0 0 0.25em color-mix(in oklch, var(--color-accent-success) 25%, transparent);
  }

  .headshot {
    display: grid;
    gap: var(--space-4);
    width: min(100%, 420px);
    margin: 0;
  }

  .headshot__photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
  }

  .headshot figcaption {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  .headshot figcaption span {
    color: var(--text-tertiary);
    font-size: 0.9rem;
  }

  .headshot__download svg {
    transition: transform var(--dur-normal) var(--ease-out-expo);
  }

  .headshot__download:hover svg {
    transform: translateY(3px);
  }

  /* ─── Sections ─────────────────────────────────────────────────────── */
  .kit-section {
    padding-block: clamp(3.5rem, 8vw, 6rem);
    border-top: 1px solid var(--border-subtle);
  }

  .kit-section__head {
    display: grid;
    gap: var(--space-3);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .kit-section__head h2 {
    margin: 0;
    font-size: clamp(3.5rem, 11vw, 7rem);
  }

  .kit-section__head p {
    max-width: 48ch;
    margin: 0;
    font-size: 1.05rem;
  }

  /* ─── Bios ─────────────────────────────────────────────────────────── */
  .bios {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--border-default);
  }

  .bio {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-8);
    border-top: 1px solid var(--border-default);
  }

  .bio__side {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }

  .bio__label {
    margin: 0;
    color: var(--color-accent);
    font-size: clamp(2.4rem, 5vw, 3.5rem);
  }

  .bio__count {
    margin: 0;
    color: var(--text-tertiary);
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
  }

  .bio__text {
    max-width: var(--measure);
  }

  .bio__text p {
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(1.05rem, 1.5vw, 1.15rem);
  }

  .bio__text p + p {
    margin-top: var(--space-4);
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 0.9rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-primary);
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease-out-expo),
      border-color var(--dur-fast) var(--ease-out-expo),
      color var(--dur-fast) var(--ease-out-expo);
  }

  .copy-btn svg {
    width: 16px;
    height: 16px;
  }

  .copy-btn:hover {
    border-color: var(--text-primary);
  }

  .copy-btn.is-copied {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .copy-btn--icon {
    justify-content: center;
    width: 44px;
    padding: 0;
  }

  /* ─── Facts & topics ───────────────────────────────────────────────── */
  .kit-split {
    display: grid;
    gap: clamp(3.5rem, 8vw, 5rem);
  }

  .facts {
    margin: 0;
    border-bottom: 1px solid var(--border-default);
  }

  .facts__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-1) var(--space-4);
    align-items: center;
    padding-block: var(--space-4);
    border-top: 1px solid var(--border-default);
  }

  .facts dt {
    grid-column: 1;
    color: var(--text-tertiary);
    font-size: 0.9rem;
  }

  .facts dd {
    grid-column: 1;
    display: flex;
    align-items: center;
    gap: 0.55em;
    margin: 0;
    color: var(--text-primary);
    font-size: 1.1rem;
    font-weight: 560;
    line-height: 1.4;
  }

  .facts .copy-btn {
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  .topics--large li {
    padding: 0.5rem 1rem;
    font-size: 1.05rem;
  }

  /* ─── Links ────────────────────────────────────────────────────────── */
  .links {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--border-default);
  }

  .links a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-1) var(--space-4);
    align-items: center;
    padding-block: var(--space-5);
    border-top: 1px solid var(--border-default);
    color: var(--text-primary);
    text-decoration: none;
  }

  .links__label {
    color: var(--text-tertiary);
    font-size: 0.9rem;
  }

  .links__handle {
    grid-column: 1;
    overflow-wrap: anywhere;
    font-size: clamp(1.5rem, 3.4vw, 2.4rem);
    font-stretch: var(--stretch-head);
    font-weight: 760;
    line-height: 1.1;
    transition: color var(--dur-fast) var(--ease-out-expo);
  }

  .links svg {
    grid-column: 2;
    grid-row: 1 / span 2;
    width: 28px;
    height: 28px;
    color: var(--text-tertiary);
    transition:
      transform var(--dur-normal) var(--ease-out-expo),
      color var(--dur-fast) var(--ease-out-expo);
  }

  .links a:hover .links__handle,
  .links a:hover svg {
    color: var(--color-accent);
  }

  .links a:hover svg {
    transform: translate(4px, -4px);
  }

  @media (min-width: 900px) {
    .kit-hero__inner {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      align-items: end;
    }

    .headshot {
      justify-self: end;
    }

    .bio {
      grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 2fr);
      gap: var(--space-12);
    }

    .bio__side {
      flex-direction: column;
      align-items: start;
      align-content: start;
    }

    .kit-split {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: var(--space-16);
    }

    .links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-12);
    }
  }
</style>
