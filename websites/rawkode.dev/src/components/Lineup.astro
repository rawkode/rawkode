---
import type { CollectionEntry } from 'astro:content';

type App = CollectionEntry<'apps'>['data'];

interface Props {
  /** Apps in billing order: the first is the headliner. */
  apps: App[];
}

const { apps } = Astro.props;

// Billed like a festival poster: one headliner, two main-stage acts,
// then everyone else on the undercard.
const tiers = [apps.slice(0, 1), apps.slice(1, 3), apps.slice(3)].filter((tier) => tier.length > 0);

function hrefFor(app: App) {
  const repoUrl = app.repoUrl ?? (app.repoPath ? `https://github.com/rawkode/rawkode/tree/main/${app.repoPath}` : null);
  return app.websiteUrl ?? repoUrl;
}

const languages = new Set(['Rust', 'Swift', 'CUE', 'Go', 'TypeScript']);
function stackFor(app: App) {
  const language = app.tags.find((tag) => languages.has(tag));
  return [language, app.platform.join(' / ')].filter(Boolean).join(' · ');
}
---

<ol class="bill" role="list">
  {tiers.map((tier, tierIndex) => (
    <li class:list={['bill__tier', `bill__tier--${tierIndex + 1}`]}>
      <ul class="bill__acts" role="list">
        {tier.map((app) => {
          const href = hrefFor(app);
          const Tag = href ? 'a' : 'div';
          return (
            <li class="bill__slot">
              <Tag
                class="act"
                {...(href ? { href, target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                <span class="act__name poster" data-text={app.name}>{app.name}</span>
                <span class="act__tagline">
                  {app.tagline}
                  {app.status === 'in-development' && <em class="act__status">In development</em>}
                  {app.status === 'beta' && <em class="act__status">Beta</em>}
                </span>
                <span class="act__stack">{stackFor(app)}</span>
                {href && <span class="sr-only">(opens in a new tab)</span>}
              </Tag>
            </li>
          );
        })}
      </ul>
    </li>
  ))}
</ol>

<style>
  .bill {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
    container-type: inline-size;
  }

  .bill__acts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: start;
    gap: clamp(2rem, 4vw, 3rem) clamp(2rem, 5vw, 3.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bill__slot {
    display: flex;
    align-items: start;
    min-width: 0;
  }

  /* Each tier is capped so its longest billing still fits the column. */
  .bill__tier--1 { --tier-size: min(11rem, 100cqi / 7.6); }
  .bill__tier--2 { --tier-size: clamp(2.4rem, 8cqi, 6.5rem); }
  .bill__tier--3 { --tier-size: clamp(2.1rem, 4.8cqi, 3.9rem); }

  .act {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    color: var(--text-primary);
    text-decoration: none;
  }

  .act__name {
    position: relative;
    display: block;
    font-size: var(--tier-size);
    white-space: nowrap;
  }

  /* Hover: pink rolls across the name like ink on a screen print. */
  .act__name::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    color: var(--color-accent);
    clip-path: inset(0 100% 0 0);
    transition: clip-path var(--dur-slow) var(--ease-out-expo);
    pointer-events: none;
  }

  a.act:hover .act__name::after,
  a.act:focus-visible .act__name::after {
    clip-path: inset(0 0 0 0);
  }

  a.act:hover,
  a.act:focus-visible {
    color: var(--text-primary);
  }

  .act__tagline {
    max-width: 34ch;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.45;
    text-wrap: balance;
  }

  .bill__tier--1 .act__tagline {
    max-width: none;
    color: var(--text-primary);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
  }

  .act__status {
    display: inline-block;
    margin-left: 0.5em;
    padding: 0.1em 0.45em;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    font-size: 0.78em;
    font-style: normal;
    font-weight: 600;
    white-space: nowrap;
    vertical-align: 0.08em;
  }

  .act__stack {
    color: var(--text-tertiary);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  /* Poster diamonds between acts. Only where a tier can't wrap mid-line,
     so a diamond never starts a line on its own. */
  .bill__slot + .bill__slot::before {
    flex: none;
    background: var(--color-accent);
    transform: rotate(45deg);
  }

  @media (max-width: 639px) {
    /* One act per line on phones, a diamond between each. */
    .bill__acts {
      flex-direction: column;
      align-items: center;
      gap: 0;
    }

    .bill__slot {
      flex-direction: column;
      align-items: center;
    }

    .bill__slot + .bill__slot::before {
      content: "";
      width: 0.5rem;
      height: 0.5rem;
      margin: clamp(1.75rem, 4vw, 2.5rem) 0;
    }
  }

  @media (min-width: 1100px) {
    .bill__acts {
      column-gap: 0;
    }

    .bill__slot + .bill__slot::before {
      content: "";
      align-self: start;
      width: 0.7rem;
      height: 0.7rem;
      margin: calc(var(--tier-size) * 0.36) clamp(1rem, 3vw, 2.5rem) 0;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .bill__tier {
        animation: tier-in linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 70%;
      }

      @keyframes tier-in {
        from { transform: translateY(2.5rem) scale(0.96); }
        to { transform: none; }
      }
    }
  }
</style>
