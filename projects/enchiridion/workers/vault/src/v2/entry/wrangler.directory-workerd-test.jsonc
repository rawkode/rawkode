{
  "name": "enchiridion-v2-directory-workerd-test",
  "main": "workerd-directory-entry.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "CREDENTIAL_DIRECTORY_DO", "class_name": "CredentialDirectoryDO" },
      { "name": "OWNER_VAULT_V2_DO", "class_name": "OwnerVaultV2" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CredentialDirectoryDO"] },
    { "tag": "v2", "new_sqlite_classes": ["OwnerVaultV2"] }
  ],
  "vars": {
    "ENCHIRIDION_V2_ACCESS_TEAM_DOMAIN": "team.cloudflareaccess.com",
    "ENCHIRIDION_V2_ACCESS_AUDIENCE": "fixture-audience",
    "ENCHIRIDION_V2_ACCESS_JWKS_CACHE_TTL_SECONDS": "60",
    "ENCHIRIDION_V2_ACCESS_JWKS_REFRESH_COOLDOWN_SECONDS": "10",
    "ENCHIRIDION_V2_ACCESS_MAXIMUM_ASSERTION_LIFETIME_SECONDS": "300",
    "ENCHIRIDION_V2_CREDENTIAL_BINDING_CURRENT_KEY_ID": "current",
    "ENCHIRIDION_V2_CREDENTIAL_BINDING_CURRENT_SECRET": "fixture-issuer-current-secret-0123456789",
    "ENCHIRIDION_V2_CREDENTIAL_BINDING_READ_KEYS_JSON": "[{\"keyID\":\"current\",\"secret\":\"fixture-issuer-current-secret-0123456789\"},{\"keyID\":\"prior\",\"secret\":\"fixture-issuer-prior-secret-0123456789\"}]",
    "ENCHIRIDION_V2_DIRECTORY_CAPABILITY_CURRENT_KEY_ID": "directory",
    "ENCHIRIDION_V2_DIRECTORY_CAPABILITY_CURRENT_SECRET": "fixture-capability-current-secret-0123456789",
    "ENCHIRIDION_V2_DIRECTORY_CAPABILITY_PRIOR_KEYS_JSON": "[]",
    "ENCHIRIDION_V2_CREDENTIAL_QUOTA": "8"
  }
}
