<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	P6 "Widgets" task (plan §Platform parity) — iOS half of
	`EnchiridionMacWidget.entitlements`; see that file's comment for the
	full rationale. iOS has no `com.apple.security.app-sandbox` concept
	(see `EnchiridionIOS.entitlements`'s comment), so only the App Group
	key is needed here.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.rawkode.enchiridion2</string>
	</array>
</dict>
</plist>
