{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcsIgnored": false,
  "files": {
    "ignoreUnknown": true,
    "includes": ["**/src/**/*.ts", "**/*.json", "**/*.jsonc", "!**/node_modules", "!**/dist"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    }
  }
}
